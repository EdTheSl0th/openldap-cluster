resource "local_file" "inventory" {
  filename = "${path.module}/../inventory/hosts.yml"
  content = join("", [
    "# Generated by terraform/inventory.tf - do not edit.\n",
    yamlencode({
      all = {
        vars = {
          ansible_user                 = var.ssh_user
          ansible_ssh_private_key_file = local.provisioning_private_key_path
          ansible_python_interpreter   = "auto_silent"
          private_subnet               = local.subnet_cidr
          hcloud_network_id            = hcloud_network.internal_network.id
          # Reserved for the LDAP shared IP (alias IP, moved by keepalived);
          # automatic VM IPs start at .11.
          ldap_vip = cidrhost(local.subnet_cidr, 10)
        }
        hosts = {
          for name, vm in local.vms : name => merge(
            {
              ansible_host     = hcloud_server.vm[name].ipv4_address
              hcloud_server_id = hcloud_server.vm[name].id
              private_ip       = vm.private_ip
              fqdn             = vm.fqdn
              image            = vm.image
            },
            contains(keys(hcloud_volume.data), name) ? { data_volume = hcloud_volume.data[name].linux_device } : {},
          )
        }
        children = {
          for g, members in local.groups : g => { hosts = { for m in members : m => null } }
        }
      }
    }),
  ])
  file_permission = "0600"

  depends_on = [hcloud_volume_attachment.data]
}
