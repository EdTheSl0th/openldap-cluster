"""Provider "hetzner": route the LDAP shared IP (Hetzner Cloud alias IP) here.

Called by notify-master when keepalived makes this node VRRP master. Removes
the alias IP from all peers (works while they are powered off) and assigns it
to this server. Retries, because Hetzner rejects actions while a server is
locked by another action.
"""
import json
import sys
import syslog
import time
import urllib.error
import urllib.request

API = "https://api.hetzner.cloud/v1"
CONF = "/etc/ldap-ha/hetzner.json"


def log(msg):
    syslog.syslog(syslog.LOG_NOTICE, "hetzner-failover: " + msg)
    print(msg, file=sys.stderr)


class Hcloud:
    def __init__(self, cfg):
        self.cfg = cfg

    def call(self, method, path, body=None):
        req = urllib.request.Request(
            API + path,
            method=method,
            data=json.dumps(body).encode() if body is not None else None,
            headers={
                "Authorization": "Bearer " + self.cfg["token"],
                "Content-Type": "application/json",
            },
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.load(resp)

    def aliases(self, server):
        srv = self.call("GET", "/servers/%d" % server)["server"]
        for net in srv["private_net"]:
            if net["network"] == self.cfg["network"]:
                return net["alias_ips"]
        raise RuntimeError("server %d not attached to network %d" % (server, self.cfg["network"]))

    def set_aliases(self, server, ips):
        action = self.call(
            "POST",
            "/servers/%d/actions/change_alias_ips" % server,
            {"network": self.cfg["network"], "alias_ips": ips},
        )["action"]
        for _ in range(60):
            status = self.call("GET", "/actions/%d" % action["id"])["action"]
            if status["status"] == "success":
                return
            if status["status"] == "error":
                raise RuntimeError("action %d failed: %s" % (action["id"], status["error"]))
            time.sleep(1)
        raise RuntimeError("action %d timed out" % action["id"])


def main():
    with open(CONF) as fh:
        cfg = json.load(fh)
    api = Hcloud(cfg)
    vip = cfg["vip"]
    for attempt in range(1, 31):
        try:
            for peer in cfg["peers"]:
                current = api.aliases(peer)
                if vip in current:
                    log("removing %s from server %d" % (vip, peer))
                    api.set_aliases(peer, [ip for ip in current if ip != vip])
            current = api.aliases(cfg["self"])
            if vip not in current:
                log("assigning %s to server %d" % (vip, cfg["self"]))
                api.set_aliases(cfg["self"], current + [vip])
            log("%s is routed to server %d" % (vip, cfg["self"]))
            return 0
        except (urllib.error.URLError, RuntimeError, KeyError) as exc:
            detail = exc.read().decode(errors="replace") if isinstance(exc, urllib.error.HTTPError) else str(exc)
            log("attempt %d failed: %s" % (attempt, detail))
            time.sleep(2)
    return 1


if __name__ == "__main__":
    sys.exit(main())
