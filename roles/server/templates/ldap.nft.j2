# {{ ansible_managed }}
table inet ldap_filter {
  set ldap_clients {
    type ipv4_addr
    flags interval
    elements = { {{ ldap_allowed_networks | join(', ') }} }
  }

  chain input {
    type filter hook input priority 0; policy drop;
    iif "lo" accept
    ct state established,related accept
    ct state invalid drop
    meta l4proto { icmp, ipv6-icmp } accept
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept
    tcp dport {{ ldap_firewall_ssh_port }} accept
    ip saddr @ldap_clients tcp dport { 389, 636 } accept
{% if ldap_vip | length > 0 %}
    # VRRP between the providers (openldap.cluster.ha)
{% for peer in _ldap_peers %}
    ip saddr {{ _ldap_peer_addr[peer] }} ip protocol vrrp accept
{% endfor %}
{% endif %}
{% for rule in ldap_firewall_extra_rules %}
    {{ rule }}
{% endfor %}
  }
}
