# Debian with systemd as PID 1 - close to a VM for the roles under test.
FROM {{ item.image }}

ENV container=docker DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      systemd systemd-sysv python3 python3-apt sudo iproute2 procps ca-certificates \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* \
 && rm -f /lib/systemd/system/multi-user.target.wants/getty* \
          /lib/systemd/system/sysinit.target.wants/systemd-firstboot.service

STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]
